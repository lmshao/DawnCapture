<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UX prototype layout (1120x720 app, 176px sidebar) -->
    <x:Double x:Key="DawnAppWidth">1120</x:Double>
    <x:Double x:Key="DawnAppHeight">720</x:Double>
    <!-- GridLength, because it is consumed by ColumnDefinition.Width. -->
    <GridLength x:Key="DawnNavPaneWidth">176</GridLength>
    <x:Double x:Key="DawnPageMaxWidth">980</x:Double>
    <x:Double x:Key="DawnSettingsMaxWidth">850</x:Double>
    <x:Double x:Key="DawnSettingsControlWidth">250</x:Double>
    <GridLength x:Key="DawnSettingsControlColumnWidth">250</GridLength>
    <Thickness x:Key="DawnSettingsScrollPadding">0,0,12,0</Thickness>
    <x:Double x:Key="DawnAboutMaxWidth">560</x:Double>
    <Thickness x:Key="DawnPagePadding">44,38,44,34</Thickness>
    <Thickness x:Key="DawnCapturePagePadding">44,24,44,0</Thickness>

    <Color x:Key="DawnAccentColor">#D85B42</Color>
    <Color x:Key="DawnAccentHoverColor">#BF4933</Color>
    <Color x:Key="DawnTextColor">#1C2024</Color>
    <Color x:Key="DawnTextMutedColor">#626971</Color>
    <Color x:Key="DawnTextFaintColor">#858C94</Color>
    <Color x:Key="DawnStrokeColor">#D6D9DD</Color>
    <Color x:Key="DawnStrokeStrongColor">#BDC2C8</Color>
    <Color x:Key="DawnDangerColor">#C42B1C</Color>
    <Color x:Key="DawnSurfaceMutedColor">#F4F5F7</Color>
    <Color x:Key="DawnSurfaceHoverColor">#EBEEF2</Color>

    <SolidColorBrush x:Key="DawnAccentBrush" Color="{StaticResource DawnAccentColor}" />
    <SolidColorBrush x:Key="DawnAccentHoverBrush" Color="{StaticResource DawnAccentHoverColor}" />
    <SolidColorBrush x:Key="DawnTextBrush" Color="{StaticResource DawnTextColor}" />
    <SolidColorBrush x:Key="DawnTextMutedBrush" Color="{StaticResource DawnTextMutedColor}" />
    <SolidColorBrush x:Key="DawnTextFaintBrush" Color="{StaticResource DawnTextFaintColor}" />
    <SolidColorBrush x:Key="DawnStrokeBrush" Color="{StaticResource DawnStrokeColor}" />
    <SolidColorBrush x:Key="DawnStrokeStrongBrush" Color="{StaticResource DawnStrokeStrongColor}" />
    <SolidColorBrush x:Key="DawnDangerBrush" Color="{StaticResource DawnDangerColor}" />
    <SolidColorBrush x:Key="DawnSurfaceMutedBrush" Color="{StaticResource DawnSurfaceMutedColor}" />
    <SolidColorBrush x:Key="DawnSurfaceHoverBrush" Color="{StaticResource DawnSurfaceHoverColor}" />

    <Style x:Key="DawnNavCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource DawnTextFaintBrush}" />
    </Style>

    <Style x:Key="DawnCompactPageHeaderStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="7" />
        <Setter Property="Margin" Value="0,0,0,28" />
    </Style>

    <Style x:Key="DawnEyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource DawnTextFaintBrush}" />
    </Style>

    <Style x:Key="DawnPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DawnTextBrush}" />
    </Style>

    <Style x:Key="DawnPageDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource DawnTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="DawnSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DawnTextFaintBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="DawnSettingsSubsectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource DawnTextFaintBrush}" />
        <Setter Property="Padding" Value="0,14,0,2" />
    </Style>

    <Style x:Key="DawnSettingsGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="0,0,0,9" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style x:Key="DawnSettingsRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="66" />
        <Setter Property="ColumnSpacing" Value="30" />
    </Style>

    <Style x:Key="DawnSettingsComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="{StaticResource DawnSettingsControlWidth}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DawnSettingsToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="OnContent" Value="" />
    </Style>

    <Style x:Key="TimerTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>