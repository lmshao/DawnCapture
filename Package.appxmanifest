<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap">

  <!-- Name and Publisher are assigned by the Store for this product (Partner Center >
       Product identity) and must match it exactly - a package whose Publisher differs is
       rejected at submission. Those used to be a locally generated GUID and a name-only
       publisher left over from self-signed test builds.

       distribute.ps1 reads Publisher from here and uses it as the subject of the signing
       certificate, so the manifest and the certificate cannot drift apart: change one and
       the next package is signed consistently.

       The phone identity that sat below Identity is gone with the mp namespace - a Windows
       Phone artifact that a desktop package has never needed. -->
  <Identity
    Name="SHAOLiming.DawnCapture"
    Publisher="CN=C56CB3C0-9DE6-4561-B8C7-F0F6721C4DC9"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>DawnCapture</DisplayName>
    <PublisherDisplayName>SHAO Liming</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows.Desktop only. The Windows.Universal entry arrived with the template: for a
         desktop app it says nothing useful and only widens the set of devices the package
         claims to support. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <!-- Description used to repeat the app name, which then showed up verbatim on the
           tile. The description customers read in the Store comes from the listing in
           Partner Center; this one is what the shell shows for the app itself. -->
      <uap:VisualElements
        DisplayName="DawnCapture"
        Description="A lightweight, focused screen recorder for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Notification button activation (OpenFolder action). -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="3B2C5E9A-7F14-4D9A-9E1C-2A6B8D0F5C31" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="DawnCapture.exe" DisplayName="DawnCapture" Arguments="----AppNotificationActivated:">
              <com:Class Id="3B2C5E9A-7F14-4D9A-9E1C-2A6B8D0F5C31" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone"/>
  </Capabilities>
</Package>
