<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.0.0</Version>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DawnCapture</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- This project does not use AOT publishing, so field-based [ObservableProperty] AOT warnings do not apply. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Label="PackageAssets">
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="PRIVACY-POLICY.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AboutLogo.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <None Include="Package.appxmanifest" Condition="'$(EnableMsixTooling)' != 'true'" />
    <AppxManifest Include="Package.appxmanifest" Condition="'$(EnableMsixTooling)' == 'true'" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--
      Trimming is disabled for Release: WinUI 3 + CommunityToolkit.Mvvm
      reflection + System.Text.Json all break when trimmed (observed
      TypeLoadException for System.Environment / WindowsAppRuntime.Projection
      at startup). Enable explicitly with -p:PublishTrimmed=true if ever needed.
    -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!--
    Workaround for WindowsAppSDK #6071: self-contained unpackaged builds miss
    Microsoft.WindowsAppRuntime.Insights.Resource.dll, which makes
    AppNotificationManager.Register() throw 0x8007007E (module not found).
    The DLL only ships inside the framework MSIX in the NuGet package
    ($(MicrosoftWindowsAppSDKPackageDir)tools\MSIX), which self-contained
    payload extraction does not read, so extract it explicitly from there.
    MSIX files are ZIP archives and bsdtar (ships with Windows 10 1803+) can
    pull the single entry. Remove this workaround once an SDK release
    containing WindowsAppSDK PR #6725 ships.
  -->
  <PropertyGroup Condition="'$(WindowsAppSDKSelfContained)' == 'true' And '$(WindowsPackageType)' == 'None'">
    <InsightsResourceMsix>$(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(Platform)\Microsoft.WindowsAppRuntime.2.msix</InsightsResourceMsix>
  </PropertyGroup>
  <Target Name="CopyInsightsResourceDll"
          AfterTargets="Build"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true' And '$(WindowsPackageType)' == 'None'">
    <MakeDir Directories="$(OutDir)" />
    <Exec WorkingDirectory="$(OutDir)"
          Command="tar -xf &quot;$(InsightsResourceMsix)&quot; -C . Microsoft.WindowsAppRuntime.Insights.Resource.dll"
          Condition="Exists('$(InsightsResourceMsix)')" />
  </Target>
  <Target Name="CopyInsightsResourceDllToPublish"
          AfterTargets="Publish"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true' And '$(WindowsPackageType)' == 'None'">
    <MakeDir Directories="$(PublishDir)" />
    <Exec WorkingDirectory="$(PublishDir)"
          Command="tar -xf &quot;$(InsightsResourceMsix)&quot; -C . Microsoft.WindowsAppRuntime.Insights.Resource.dll"
          Condition="Exists('$(InsightsResourceMsix)')" />
  </Target>

  <!--
    WinUI 3 generates the app's own resources.pri (DawnCapture.pri) into the
    build output directory, but `dotnet publish` (unpackaged, custom
    PublishDir) does not copy it. Without it the app crashes at startup with
    0xC000027B in Microsoft.UI.Xaml.dll, so copy it explicitly.
  -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pri"
      DestinationFolder="$(PublishDir)"
      Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
  </Target>
</Project>