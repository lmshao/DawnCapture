<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnCapture.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32" Spacing="12">
        <TextBlock Text="{Binding AppName}" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="{Binding Description}" />
        <TextBlock Text="{Binding Version}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</Page>
