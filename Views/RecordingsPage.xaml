<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnCapture.Views.RecordingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DawnCapture.Models">

    <Grid Padding="{StaticResource DawnPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="28">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="7">
                    <TextBlock Style="{StaticResource DawnEyebrowTextStyle}" x:Uid="Recordings_Eyebrow" Text="Local library" />
                    <TextBlock Style="{StaticResource DawnPageTitleStyle}" x:Uid="Recordings_Title" Text="Recordings" />
                    <TextBlock
                        Style="{StaticResource DawnPageDescriptionStyle}"
                        Text="Your recently saved video and audio recordings."
                        x:Uid="Recordings_Desc" />
                </StackPanel>
                <TextBox
                    Grid.Column="1"
                    Width="210"
                    VerticalAlignment="Bottom"
                    PlaceholderText="Search recordings"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    x:Uid="Recordings_Search" />
            </Grid>

            <Grid Height="44" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource DawnTextFaintBrush}">
                    <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.VideoCount, Mode=OneWay}" />
                    <Run Text=" videos" />
                </TextBlock>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource DawnTextFaintBrush}">
                    <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.AudioCount, Mode=OneWay}" />
                    <Run Text=" audio" />
                </TextBlock>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource DawnTextFaintBrush}"
                    Text="{x:Bind ViewModel.TotalSizeLabel, Mode=OneWay}" />
                <Button
                    Grid.Column="4"
                    Command="{x:Bind ViewModel.OpenFolderCommand}"
                    Content="Open folder"
                    x:Uid="Recordings_OpenFolder" />
            </Grid>
            <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            Margin="0,0,0,0"
            ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RecordingListItem">
                    <Grid MinHeight="88" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Height="64"
                            Background="{StaticResource DawnSurfaceMutedBrush}"
                            BorderBrush="{StaticResource DawnStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                            <Grid>
                                <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource DawnAccentBrush}" />
                                <Border
                                    Width="26"
                                    Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{StaticResource DawnStrokeStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="13">
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{StaticResource DawnTextMutedBrush}"
                                        Glyph="&#xE768;" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="{x:Bind DateDuration}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DawnTextFaintBrush}"
                            FontSize="11"
                            Text="{x:Bind TypeLabel}" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DawnTextFaintBrush}"
                            FontSize="11"
                            Text="{x:Bind SizeLabel}" />
                        <Button
                            Grid.Column="4"
                            Width="30"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Center"
                            Content="..."
                            x:Uid="Recordings_More" />
                        <Border
                            Grid.ColumnSpan="5"
                            VerticalAlignment="Bottom"
                            BorderBrush="{StaticResource DawnStrokeBrush}"
                            BorderThickness="0,0,0,1" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
