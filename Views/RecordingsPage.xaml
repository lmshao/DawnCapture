<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnCapture.Views.RecordingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DawnCapture.Models">

    <Grid Padding="{StaticResource DawnPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="28">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="7">
                    <TextBlock Style="{StaticResource DawnEyebrowTextStyle}" x:Uid="Recordings_Eyebrow" Text="Local library" />
                    <TextBlock Style="{StaticResource DawnPageTitleStyle}" x:Uid="Recordings_Title" Text="Recordings" />
                    <TextBlock
                        Style="{StaticResource DawnPageDescriptionStyle}"
                        Text="Your recently saved video and audio recordings."
                        x:Uid="Recordings_Desc" />
                </StackPanel>
                <TextBox
                    Grid.Column="1"
                    Width="210"
                    VerticalAlignment="Bottom"
                    PlaceholderText="Search recordings"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    x:Uid="Recordings_Search" />
            </Grid>

            <Grid Height="44" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{StaticResource DawnTextFaintBrush}"
                    Text="{x:Bind ViewModel.VideoCountLabel, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource DawnTextFaintBrush}"
                    Text="{x:Bind ViewModel.AudioCountLabel, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource DawnTextFaintBrush}"
                    Text="{x:Bind ViewModel.TotalSizeLabel, Mode=OneWay}" />
                <Button
                    Grid.Column="4"
                    Command="{x:Bind ViewModel.OpenFolderCommand}"
                    Content="Open folder"
                    x:Uid="Recordings_OpenFolder" />
            </Grid>
            <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers: name sits directly above the filename text column -->
            <Grid
                Grid.Row="0"
                Margin="0,10,0,6"
                ColumnSpacing="12"
                Visibility="{x:Bind ViewModel.HasRecordings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="1"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortByNameCommand}">
                    <TextBlock
                        Foreground="{StaticResource DawnTextFaintBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.NameColumnHeader, Mode=OneWay}" />
                </Button>
                <Button
                    Grid.Column="2"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortByUpdatedAtCommand}">
                    <TextBlock
                        Foreground="{StaticResource DawnTextFaintBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.UpdatedColumnHeader, Mode=OneWay}" />
                </Button>
                <Button
                    Grid.Column="3"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortBySizeCommand}">
                    <TextBlock
                        Foreground="{StaticResource DawnTextFaintBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.SizeColumnHeader, Mode=OneWay}" />
                </Button>
            </Grid>

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasRecordings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RecordingListItem">
                        <Grid MinHeight="70" Padding="0,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail -->
                            <Button
                                Grid.Column="0"
                                Width="96"
                                Height="54"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ElementName=PageRoot, Path=ViewModel.PlayRecordingCommand}"
                                CommandParameter="{x:Bind}"
                                ToolTipService.ToolTip="Play"
                                x:Uid="Recordings_Play">
                                <Border
                                    Width="96"
                                    Height="54"
                                    Background="{StaticResource DawnSurfaceMutedBrush}"
                                    BorderBrush="{StaticResource DawnStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid>
                                        <Image
                                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Grid Visibility="{x:Bind HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource DawnAccentBrush}" />
                                        </Grid>
                                        <Border
                                            Width="24"
                                            Height="24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{StaticResource DawnStrokeStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <FontIcon
                                                FontSize="9"
                                                Foreground="{StaticResource DawnTextMutedBrush}"
                                                Glyph="&#xE768;" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Filename block -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    LineHeight="18"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{StaticResource DawnTextFaintBrush}"
                                    FontSize="11"
                                    LineHeight="16"
                                    Text="{x:Bind FormatLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="{x:Bind UpdatedAtLabel}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="{x:Bind SizeLabel}" />

                            <Button
                                Grid.Column="4"
                                Width="36"
                                Height="36"
                                Margin="0,0,10,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="More"
                                x:Uid="Recordings_More">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Click="OnPlayMenuItemClick"
                                            Icon="Play"
                                            Tag="{x:Bind}"
                                            x:Uid="Recordings_Action_Play" />
                                        <MenuFlyoutItem
                                            Click="OnRenameMenuItemClick"
                                            Icon="Rename"
                                            Tag="{x:Bind}"
                                            x:Uid="Recordings_Action_Rename" />
                                        <MenuFlyoutItem
                                            Click="OnRevealMenuItemClick"
                                            Icon="OpenFile"
                                            Tag="{x:Bind}"
                                            x:Uid="Recordings_Action_Reveal" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Click="OnDeleteMenuItemClick"
                                            Icon="Delete"
                                            Tag="{x:Bind}"
                                            x:Uid="Recordings_Action_Delete" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Border
                                Grid.ColumnSpan="5"
                                Margin="0,10,0,-10"
                                VerticalAlignment="Bottom"
                                BorderBrush="{StaticResource DawnStrokeBrush}"
                                BorderThickness="0,0,0,1" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{StaticResource DawnTextFaintBrush}"
                Text="No recordings yet. Completed captures will appear here."
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                x:Uid="Recordings_Empty" />
        </Grid>
    </Grid>
</Page>
