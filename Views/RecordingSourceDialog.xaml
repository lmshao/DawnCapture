<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DawnCapture.Views.RecordingSourceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择录制方式"
    PrimaryButtonText="开始录制"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel MinWidth="360" Spacing="12">
        <RadioButton
            x:Name="DesktopModeRadio"
            Content="桌面录制"
            GroupName="RecordingMode"
            IsChecked="True"
            Checked="ModeRadio_Checked" />

        <RadioButton
            x:Name="WindowModeRadio"
            Content="窗口录制"
            GroupName="RecordingMode"
            Checked="ModeRadio_Checked" />

        <RadioButton
            x:Name="RegionModeRadio"
            Content="区域录制"
            GroupName="RecordingMode"
            Checked="ModeRadio_Checked" />

        <TextBlock
            x:Name="DesktopHint"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="将录制主窗口所在的显示器。" />

        <TextBlock
            x:Name="RegionHint"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="将进入区域选择模式，拖拽选择要录制的区域。"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="WindowHint"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="请选择要录制的窗口："
            Visibility="Collapsed" />

        <ListView
            x:Name="WindowList"
            MaxHeight="260"
            DisplayMemberPath="Title"
            SelectionMode="Single"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
