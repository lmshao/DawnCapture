<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DawnCapture.Views.RecordingControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent">
        <Border
            Background="#EB252836"
            BorderBrush="#73EF4444"
            BorderThickness="1"
            CornerRadius="7">
            <StackPanel
                Padding="7,0"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">

                <Border
                    x:Name="DragHandle"
                    MinWidth="24"
                    Height="32"
                    Background="Transparent"
                    VerticalAlignment="Center">
                    <Ellipse
                        x:Name="RecDot"
                        Width="7"
                        Height="7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="#EF4444" />
                </Border>

                <Button
                    x:Name="RecordButton"
                    Height="22"
                    MinWidth="0"
                    Padding="7,1"
                    VerticalAlignment="Center"
                    Background="#2EEF4444"
                    BorderThickness="0"
                    Click="RecordButton_Click"
                    Content="REC"
                    CornerRadius="4"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#FCA5A5" />

                <Button
                    x:Name="PauseButton"
                    Width="22"
                    Height="22"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="#2EEF4444"
                    BorderThickness="0"
                    Click="PauseButton_Click"
                    Content="II"
                    CornerRadius="4"
                    FontSize="11"
                    Foreground="#F87171"
                    Visibility="Collapsed" />

                <Button
                    x:Name="StopButton"
                    x:Uid="RecordingControl_Stop"
                    Height="22"
                    MinWidth="0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="#2EEF4444"
                    BorderThickness="0"
                    Click="StopButton_Click"
                    CornerRadius="4"
                    FontSize="11"
                    Foreground="#F87171"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="TimeText"
                    MinWidth="44"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#E8EAEF"
                    Text="00:00"
                    TextAlignment="Center" />

                <Button
                    x:Name="CancelButton"
                    Width="22"
                    Height="22"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CancelButton_Click"
                    Content="✕"
                    CornerRadius="4"
                    FontSize="11"
                    Foreground="#AEB3C2" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
