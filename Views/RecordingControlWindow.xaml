<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DawnCapture.Views.RecordingControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#E6202020">
        <StackPanel
            Padding="8,4"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">

            <Ellipse
                x:Name="RecDot"
                Width="8"
                Height="8"
                VerticalAlignment="Center"
                Fill="#EF4444" />

            <Button
                x:Name="RecordButton"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="#CCEF4444"
                Click="RecordButton_Click"
                Content="● REC"
                Foreground="White" />

            <Button
                x:Name="StopButton"
                x:Uid="RecordingControl_Stop"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="#CCEF4444"
                Click="StopButton_Click"
                Foreground="White"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="TimeText"
                VerticalAlignment="Center"
                Foreground="White"
                Text="00:00" />

            <Button
                x:Name="CancelButton"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="CancelButton_Click"
                Content="✕"
                Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
