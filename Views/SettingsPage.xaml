<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnCapture.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="{StaticResource DawnPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="7">
            <TextBlock Style="{StaticResource DawnEyebrowTextStyle}" x:Uid="Settings_Eyebrow" Text="Preferences" />
            <TextBlock Style="{StaticResource DawnPageTitleStyle}" x:Uid="Settings_Title" Text="Settings" />
            <TextBlock Style="{StaticResource DawnPageDescriptionStyle}" x:Uid="Settings_AutoSave" Text="Changes are saved automatically." />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,28,0,0"
            Padding="{StaticResource DawnSettingsScrollPadding}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource DawnSettingsMaxWidth}" Spacing="30">
                <StackPanel Spacing="0">
                    <Border BorderBrush="{StaticResource DawnStrokeStrongBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource DawnSettingsGroupTitleStyle}" x:Uid="Settings_Group_Recording" Text="Recording" />
                    </Border>

                    <Grid Style="{StaticResource DawnSettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_OutputFolder" Text="Output folder" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Where completed recordings are saved"
                                x:Uid="Settings_OutputFolder_Desc" />
                        </StackPanel>
                        <Grid
                            Grid.Column="1"
                            Width="{StaticResource DawnSettingsControlWidth}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Height="34"
                                Padding="10,0"
                                Background="{StaticResource DawnSurfaceMutedBrush}"
                                BorderBrush="{StaticResource DawnStrokeStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{StaticResource DawnTextMutedBrush}"
                                    Text="{x:Bind ViewModel.OutputFolderDisplay, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.BrowseFolderCommand}"
                                x:Uid="Common_Browse"
                                Content="Browse..." />
                        </Grid>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <TextBlock Style="{StaticResource DawnSettingsSubsectionTitleStyle}" x:Uid="Settings_Subsection_Video" Text="Video" />

                    <Grid Style="{StaticResource DawnSettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_VideoCodec" Text="Video codec" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Choose compatibility or smaller files"
                                x:Uid="Settings_VideoCodec_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource DawnSettingsComboBoxStyle}"
                            SelectedIndex="{x:Bind ViewModel.CodecIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_Codec_Avc" Content="Compatible / H.264 AVC" />
                            <ComboBoxItem x:Uid="Settings_Codec_Hevc" Content="Smaller files / H.265 HEVC" />
                        </ComboBox>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid Style="{StaticResource DawnSettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_FrameRate" Text="Frame rate" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Capture presets on the home page change frame rate and quality tier together."
                                x:Uid="Settings_FrameRate_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource DawnSettingsComboBoxStyle}"
                            SelectedIndex="{x:Bind ViewModel.FrameRateIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_FrameRate_30" Content="30 FPS" />
                            <ComboBoxItem x:Uid="Settings_FrameRate_60" Content="60 FPS" />
                        </ComboBox>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid Style="{StaticResource DawnSettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_BitrateMode" Text="Video bitrate mode" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Adaptive scales with capture size; fixed uses an exact target."
                                x:Uid="Settings_BitrateMode_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource DawnSettingsComboBoxStyle}"
                            SelectedIndex="{x:Bind ViewModel.BitrateModeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_BitrateMode_Adaptive" Content="Scale with capture size" />
                            <ComboBoxItem x:Uid="Settings_BitrateMode_Fixed" Content="Fixed target bitrate" />
                        </ComboBox>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid
                        Style="{StaticResource DawnSettingsRowStyle}"
                        Visibility="{x:Bind ViewModel.IsAdaptiveBitrateMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_AdaptiveQuality" Text="Quality tier" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Reference tiers for 1080p; actual bitrate adjusts to your capture size and frame rate."
                                x:Uid="Settings_AdaptiveQuality_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource DawnSettingsComboBoxStyle}"
                            SelectedIndex="{x:Bind ViewModel.QualityIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_Quality_Compact" Content="Smaller files" />
                            <ComboBoxItem x:Uid="Settings_Quality_Balanced" Content="Balanced" />
                            <ComboBoxItem x:Uid="Settings_Quality_High" Content="High quality" />
                        </ComboBox>
                    </Grid>
                    <Border
                        BorderBrush="{StaticResource DawnStrokeBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{x:Bind ViewModel.IsAdaptiveBitrateMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Grid
                        Style="{StaticResource DawnSettingsRowStyle}"
                        Visibility="{x:Bind ViewModel.IsAdaptiveBitrateMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_FixedBitrate" Text="Target bitrate" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Uses this exact video bitrate for every capture size."
                                x:Uid="Settings_FixedBitrate_Desc" />
                        </StackPanel>
                        <Grid
                            Grid.Column="1"
                            Width="{StaticResource DawnSettingsControlWidth}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                Minimum="1"
                                Maximum="100"
                                SmallChange="1"
                                LargeChange="5"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.FixedBitrateMbps, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource DawnTextMutedBrush}"
                                Text="Mbps"
                                x:Uid="Settings_FixedBitrate_Unit" />
                        </Grid>
                    </Grid>
                    <Border
                        BorderBrush="{StaticResource DawnStrokeBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{x:Bind ViewModel.IsAdaptiveBitrateMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <TextBlock Style="{StaticResource DawnSettingsSubsectionTitleStyle}" x:Uid="Settings_Subsection_Audio" Text="Audio" />

                    <Grid Style="{StaticResource DawnSettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_AudioQuality" Text="Audio quality" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="AAC for audio in video recordings and audio-only captures."
                                x:Uid="Settings_AudioQuality_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource DawnSettingsComboBoxStyle}"
                            SelectedIndex="{x:Bind ViewModel.AudioQualityIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_Audio_128" Content="Standard / 128 kbps" />
                            <ComboBoxItem x:Uid="Settings_Audio_192" Content="High / 192 kbps" />
                            <ComboBoxItem x:Uid="Settings_Audio_256" Content="Best / 256 kbps" />
                        </ComboBox>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <TextBlock Style="{StaticResource DawnSettingsSubsectionTitleStyle}" x:Uid="Settings_Subsection_Behavior" Text="Recording behavior" />

                    <Grid Style="{StaticResource DawnSettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_CaptureCursor" Text="Capture cursor" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Show the pointer in recorded video"
                                x:Uid="Settings_CaptureCursor_Desc" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            Style="{StaticResource DawnSettingsToggleStyle}"
                            IsOn="{x:Bind ViewModel.CaptureCursor, Mode=TwoWay}" />
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid Style="{StaticResource DawnSettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_Countdown" Text="Recording countdown" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Show a three-second countdown before recording"
                                x:Uid="Settings_Countdown_Desc" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            Style="{StaticResource DawnSettingsToggleStyle}"
                            IsOn="{x:Bind ViewModel.CountdownEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid Style="{StaticResource DawnSettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_Notification" Text="Completion notification" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Show a Windows notification after saving"
                                x:Uid="Settings_Notification_Desc" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            Style="{StaticResource DawnSettingsToggleStyle}"
                            IsOn="{x:Bind ViewModel.NotificationEnabled, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="0">
                    <Border BorderBrush="{StaticResource DawnStrokeStrongBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource DawnSettingsGroupTitleStyle}" x:Uid="Settings_Group_General" Text="General" />
                    </Border>

                    <Grid Style="{StaticResource DawnSettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource DawnSettingsControlColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_Language" Text="Language" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Restart the app after changing this setting"
                                x:Uid="Settings_Language_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource DawnSettingsComboBoxStyle}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.Languages}"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
