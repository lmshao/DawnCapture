<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnCapture.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="{StaticResource DawnPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="7">
            <TextBlock Style="{StaticResource DawnEyebrowTextStyle}" x:Uid="Settings_Eyebrow" Text="Preferences" />
            <TextBlock Style="{StaticResource DawnPageTitleStyle}" x:Uid="Settings_Title" Text="Settings" />
            <TextBlock Style="{StaticResource DawnPageDescriptionStyle}" x:Uid="Settings_AutoSave" Text="Changes are saved automatically." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="30">
                <StackPanel Spacing="0">
                    <Border BorderBrush="{StaticResource DawnStrokeStrongBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource DawnSettingsGroupTitleStyle}" x:Uid="Settings_Group_Recording" Text="Recording" />
                    </Border>

                    <Grid MinHeight="66" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_OutputFolder" Text="Output folder" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Where completed recordings are saved"
                                x:Uid="Settings_OutputFolder_Desc" />
                        </StackPanel>
                        <Grid Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Height="34"
                                Padding="10,0"
                                Background="{StaticResource DawnSurfaceMutedBrush}"
                                BorderBrush="{StaticResource DawnStrokeStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{StaticResource DawnTextMutedBrush}"
                                    Text="{x:Bind ViewModel.OutputFolderDisplay, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.BrowseFolderCommand}"
                                x:Uid="Common_Browse"
                                Content="Browse..." />
                        </Grid>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid MinHeight="66" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_FrameRate" Text="Frame rate" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Higher values create larger files"
                                x:Uid="Settings_FrameRate_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.FrameRateIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="30 FPS" />
                            <ComboBoxItem Content="60 FPS" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid MinHeight="66" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_Quality" Text="Quality" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Balanced works well for most recordings"
                                x:Uid="Settings_Quality_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.QualityIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Compact" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="High quality" />
                        </ComboBox>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid MinHeight="66" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_VideoCodec" Text="Video codec" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Choose compatibility or smaller files"
                                x:Uid="Settings_VideoCodec_Desc" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.CodecIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Compatible / H.264 AVC" />
                                <ComboBoxItem Content="Smaller files / H.265 HEVC" />
                            </ComboBox>
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Works with nearly every player, editor, browser, and upload service."
                                TextWrapping="Wrap"
                                x:Uid="Settings_Codec_Avc_Status" />
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid MinHeight="66" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_AudioQuality" Text="Audio quality" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="AAC-LC in an M4A file for audio-only recordings"
                                x:Uid="Settings_AudioQuality_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.AudioQualityIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Standard / 128 kbps" />
                            <ComboBoxItem Content="High / 192 kbps" />
                            <ComboBoxItem Content="Best / 256 kbps" />
                        </ComboBox>
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid MinHeight="66" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_CaptureCursor" Text="Capture cursor" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Show the pointer in recorded video"
                                x:Uid="Settings_CaptureCursor_Desc" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            OffContent=""
                            OnContent=""
                            IsOn="{x:Bind ViewModel.CaptureCursor, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="0">
                    <Border BorderBrush="{StaticResource DawnStrokeStrongBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource DawnSettingsGroupTitleStyle}" x:Uid="Settings_Group_General" Text="General" />
                    </Border>

                    <Grid MinHeight="66" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_Countdown" Text="Recording countdown" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Show a three-second countdown before recording"
                                x:Uid="Settings_Countdown_Desc" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            OffContent=""
                            OnContent=""
                            IsOn="{x:Bind ViewModel.CountdownEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid MinHeight="66" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_Notification" Text="Completion notification" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Show a Windows notification after saving"
                                x:Uid="Settings_Notification_Desc" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            OffContent=""
                            OnContent=""
                            IsOn="{x:Bind ViewModel.NotificationEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Border BorderBrush="{StaticResource DawnStrokeBrush}" BorderThickness="0,0,0,1" />

                    <Grid MinHeight="66" ColumnSpacing="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" x:Uid="Settings_Language" Text="Language" />
                            <TextBlock
                                Foreground="{StaticResource DawnTextFaintBrush}"
                                FontSize="11"
                                Text="Restart the app after changing this setting"
                                x:Uid="Settings_Language_Desc" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.Languages}"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
