<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnCapture.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32" Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
        <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBox x:Uid="Settings_OutputFolder" Text="{Binding OutputFolder, Mode=TwoWay}" />

        <NumberBox
            x:Uid="Settings_FrameRate"
            Value="{Binding FrameRate, Mode=TwoWay}"
            SpinButtonPlacementMode="Inline"
            Minimum="1"
            Maximum="60" />

        <NumberBox
            x:Uid="Settings_Bitrate"
            Value="{Binding BitrateKbps, Mode=TwoWay}"
            SpinButtonPlacementMode="Inline"
            Minimum="100"
            Maximum="100000" />

        <ToggleSwitch x:Uid="Settings_CaptureCursor" IsOn="{Binding CaptureCursor, Mode=TwoWay}" />

        <TextBlock x:Uid="Settings_Language" />

        <ListView
            ItemsSource="{Binding Languages}"
            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
            DisplayMemberPath="DisplayName"
            SelectionMode="Single"
            MaxHeight="132" />

        <Button x:Uid="Settings_Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" />

        <TextBlock Text="{Binding SavedMessage}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
    </StackPanel>
</Page>
