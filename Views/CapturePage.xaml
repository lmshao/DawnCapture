<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnCapture.Views.CapturePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DawnCapture.Models"
    xmlns:helpers="using:DawnCapture.Helpers">

    <Grid HorizontalAlignment="Stretch">
        <Grid
            Padding="{StaticResource DawnCapturePagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header (left-aligned, matching UX) -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Style="{StaticResource DawnCompactPageHeaderStyle}">
            <TextBlock Style="{StaticResource DawnEyebrowTextStyle}" Text="{x:Bind ViewModel.Eyebrow, Mode=OneWay}" />
            <TextBlock Style="{StaticResource DawnPageTitleStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <TextBlock
                MaxWidth="520"
                Style="{StaticResource DawnPageDescriptionStyle}"
                Text="{x:Bind ViewModel.Description, Mode=OneWay}" />
        </StackPanel>

        <!-- Workspace -->
        <Grid x:Name="Workspace" Grid.Row="1" Margin="0,0,0,10" ColumnSpacing="30" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <StackPanel Spacing="0">
                <TextBlock Style="{StaticResource DawnSectionLabelStyle}" x:Uid="Capture_ModeSection" Text="Capture mode" />

                <StackPanel x:Name="ModeButtonsPanel" Spacing="3" />

                <TextBlock
                    Margin="0,28,0,8"
                    Style="{StaticResource DawnSectionLabelStyle}"
                    Text="{x:Bind ViewModel.SourceOptionsLabel, Mode=OneWay}" />

                <Grid Height="39" Padding="8,0">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource DawnTextMutedBrush}" x:Uid="Capture_Microphone" Text="Microphone" />
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        OffContent=""
                        OnContent=""
                        IsEnabled="{x:Bind ViewModel.MicrophoneToggleEnabled, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.MicrophoneEnabled, Mode=TwoWay}" />
                </Grid>
                <TextBlock
                    Margin="8,-4,8,4"
                    FontSize="11"
                    Foreground="{StaticResource DawnTextFaintBrush}"
                    Text="No microphone detected"
                    Visibility="{x:Bind ViewModel.MicrophoneUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    x:Uid="Capture_MicrophoneUnavailable" />
                <Grid Height="39" Padding="8,0">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource DawnTextMutedBrush}" x:Uid="Capture_SystemAudio" Text="System audio" />
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        OffContent=""
                        OnContent=""
                        IsEnabled="{x:Bind ViewModel.SystemAudioToggleEnabled, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.SystemAudioEnabled, Mode=TwoWay}" />
                </Grid>
                <TextBlock
                    Margin="8,-4,8,4"
                    FontSize="11"
                    Foreground="{StaticResource DawnTextFaintBrush}"
                    Text="No playback device detected"
                    Visibility="{x:Bind ViewModel.SystemAudioUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    x:Uid="Capture_SystemAudioUnavailable" />
                <Grid
                    Height="39"
                    Padding="8,0"
                    Visibility="{x:Bind ViewModel.ShowCursorOption, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource DawnTextMutedBrush}" x:Uid="Capture_ShowCursor" Text="Show cursor" />
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        OffContent=""
                        OnContent=""
                        IsOn="{x:Bind ViewModel.ShowCursor, Mode=TwoWay}" />
                </Grid>
            </StackPanel>

            <!-- Preview -->
            <Border
                x:Name="PreviewCard"
                Grid.Column="1"
                MinHeight="360"
                Padding="14"
                VerticalAlignment="Stretch"
                Background="{StaticResource DawnSurfaceMutedBrush}"
                BorderBrush="{StaticResource DawnStrokeBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Height="25">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource DawnTextFaintBrush}"
                            Text="{x:Bind ViewModel.PreviewLabel, Mode=OneWay}" />
                        <Border
                            Padding="7,2"
                            HorizontalAlignment="Right"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{StaticResource DawnStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <TextBlock FontSize="10" Foreground="{StaticResource DawnTextMutedBrush}" x:Uid="Capture_Preview" Text="Preview" />
                        </Border>
                    </Grid>

                    <!-- Preview body (UX .capture-outline: flex 1, min-height 270, padding 16, radius 7) -->
                    <Border
                        x:Name="CaptureOutline"
                        Grid.Row="1"
                        MinHeight="270"
                        Padding="16"
                        Background="Transparent"
                        BorderBrush="{StaticResource DawnStrokeStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                        <Grid>
                        <!-- Audio-only preview -->
                        <Grid
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.ShowAudioPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="18">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind ViewModel.AudioOnlyModeLabel, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DawnTextFaintBrush}"
                                    FontSize="11"
                                    x:Uid="Capture_AudioFormatDetail"
                                    Text="AAC-LC / M4A / 48 kHz stereo" />
                            </StackPanel>
                            <Grid Height="82" HorizontalAlignment="Center">
                                <ItemsRepeater
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    ItemsSource="{x:Bind ViewModel.AudioWaveformBars, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="5" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:AudioWaveformBar">
                                            <Grid Width="5" Height="82">
                                                <Border
                                                    Width="5"
                                                    VerticalAlignment="Bottom"
                                                    CornerRadius="3"
                                                    Background="{StaticResource DawnAccentBrush}"
                                                    Height="{x:Bind Height, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="8,4"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{StaticResource DawnStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{x:Bind ViewModel.ShowMicrophoneStatusBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock FontSize="10" Foreground="{StaticResource DawnTextMutedBrush}" Text="{x:Bind ViewModel.MicrophoneStatusBadge, Mode=OneWay}" />
                                </Border>
                                <Border
                                    Padding="8,4"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{StaticResource DawnStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{x:Bind ViewModel.ShowSystemAudioStatusBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock FontSize="10" Foreground="{StaticResource DawnTextMutedBrush}" Text="{x:Bind ViewModel.SystemAudioStatusBadge, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.ShowEmptySource, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.EmptySourceTitle, Mode=OneWay}" />
                            <TextBlock
                                MaxWidth="330"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource DawnTextMutedBrush}"
                                Text="{x:Bind ViewModel.EmptySourceDescription, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.ChooseSourceCommand}"
                                Content="{x:Bind ViewModel.EmptySourceButton, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>

                        <ItemsRepeater
                            x:Name="MonitorGrid"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowMonitorGrid, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="200" MinColumnSpacing="12" MinRowSpacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:MonitorDisplay">
                                    <Button
                                        Height="154"
                                        Padding="10"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Top"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{StaticResource DawnStrokeBrush}"
                                        BorderThickness="1"
                                        Command="{Binding ElementName=RootPage, Path=ViewModel.SelectDisplayCommand}"
                                        CommandParameter="{x:Bind}"
                                        CornerRadius="7">
                                        <StackPanel Spacing="0">
                                            <Border
                                                Height="90"
                                                Background="{StaticResource DawnSurfaceMutedBrush}"
                                                BorderBrush="{StaticResource DawnStrokeStrongBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Margin="0,9,0,0" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource DawnTextFaintBrush}"
                                                Text="{x:Bind Detail}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Selected display: full-area desktop snapshot -->
                        <Grid
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.ShowDisplayPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border
                                Background="{StaticResource DawnSurfaceMutedBrush}"
                                BorderBrush="{StaticResource DawnStrokeStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Image
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Source="{x:Bind ViewModel.SelectedDisplayThumbnail, Mode=OneWay}"
                                    Stretch="Uniform" />
                            </Border>
                            <Border
                                Margin="8"
                                Padding="7,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#24282D"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="White"
                                    Text="{x:Bind ViewModel.SelectedDisplayBadge, Mode=OneWay}" />
                            </Border>
                        </Grid>

                        <!-- Region preview: thumbnail from selected screen bounds -->
                        <Grid
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.ShowRegionPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border
                                Background="{StaticResource DawnSurfaceMutedBrush}"
                                BorderBrush="#8B5CF6"
                                BorderThickness="2"
                                CornerRadius="4">
                                <Image
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Source="{x:Bind ViewModel.RegionThumbnail, Mode=OneWay}"
                                    Stretch="Uniform" />
                            </Border>
                            <ProgressRing
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsLoadingRegionThumbnail, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsLoadingRegionThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Border
                                Margin="8"
                                Padding="7,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#24282D"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="White"
                                    Text="{x:Bind ViewModel.RegionBadge, Mode=OneWay}" />
                            </Border>
                        </Grid>

                        <!-- Window preview: thumbnail from selected capture target -->
                        <Grid
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.ShowWindowPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border
                                Background="{StaticResource DawnSurfaceMutedBrush}"
                                BorderBrush="{StaticResource DawnStrokeStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Image
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Source="{x:Bind ViewModel.WindowThumbnail, Mode=OneWay}"
                                    Stretch="Uniform" />
                            </Border>
                            <ProgressRing
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsLoadingWindowThumbnail, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsLoadingWindowThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Border
                                Margin="8"
                                Padding="7,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#24282D"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="White"
                                    Text="{x:Bind ViewModel.WindowBadge, Mode=OneWay}" />
                            </Border>
                        </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" MinHeight="32" ColumnSpacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource DawnTextFaintBrush}"
                            Text="{x:Bind ViewModel.PreviewCaption, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.PreviewActionCommand}"
                            Content="{x:Bind ViewModel.PreviewActionLabel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowPreviewAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Command dock -->
        <Border
            Grid.Row="2"
            MinHeight="88"
            Margin="-44,0,-44,0"
            Padding="44,12,44,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{StaticResource DawnStrokeBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="SaveToButton"
                        MinWidth="196"
                        MaxWidth="196"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Stretch"
                        Padding="10,6">
                        <Button.Flyout>
                            <MenuFlyout x:Name="FolderFlyout">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.OpenOutputFolderCommand}" x:Uid="FolderFlyout_Open" Text="Open folder" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ChangeOutputFolderCommand}" x:Uid="FolderFlyout_Change" Text="Change folder" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="28"
                                Height="28"
                                Background="{StaticResource DawnSurfaceMutedBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource DawnTextMutedBrush}"
                                    Glyph="&#xE8B7;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" MinWidth="0">
                                <TextBlock FontSize="10" Foreground="{StaticResource DawnTextFaintBrush}" x:Uid="Dock_SaveTo" Text="Save to" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.DestinationFolderSummary, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Border Grid.Column="1" Width="1" Height="32" VerticalAlignment="Center" Background="{StaticResource DawnStrokeBrush}" />

                    <Border
                        Grid.Column="2"
                        Padding="10,6"
                        VerticalAlignment="Center"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{StaticResource DawnStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.ShowVideoQuality, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource DawnTextFaintBrush}"
                                    Text="{x:Bind ViewModel.PresetLabel, Mode=OneWay}" />
                                <Button
                                    MinWidth="88"
                                    MaxWidth="112"
                                    Padding="10,6,8,6"
                                    HorizontalContentAlignment="Stretch"
                                    Background="{ThemeResource ComboBoxBackground}"
                                    BorderBrush="{StaticResource DawnStrokeStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Flyout="{x:Bind ViewModel.PresetFlyout, Mode=OneWay}">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Text="{x:Bind ViewModel.SelectedPresetTierLabel, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <FontIcon
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource DawnTextMutedBrush}"
                                            Glyph="&#xE70D;" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource DawnTextFaintBrush}"
                                    Text="{x:Bind ViewModel.AudioQualityLabel, Mode=OneWay}" />
                                <ComboBox
                                    MinWidth="108"
                                    MaxWidth="136"
                                    ItemsSource="{x:Bind ViewModel.AudioQualityOptions, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.AudioQualityIndex, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button
                        Grid.Column="4"
                        MinHeight="40"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource DawnAccentBrush}"
                        Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                        Content="{x:Bind ViewModel.RecordButtonLabel, Mode=OneWay}"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Grid>

                <TextBlock
                    Padding="0,2,0,0"
                    FontSize="10"
                    Foreground="{StaticResource DawnTextFaintBrush}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.OutputFootnoteTooltip, Mode=OneWay}">
                    <Run Text="{x:Bind ViewModel.OutputFootnoteSpecs, Mode=OneWay}" />
                    <Run Foreground="{StaticResource DawnTextMutedBrush}" Text="{x:Bind ViewModel.OutputFootnoteHint, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Page>