<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DawnCapture.Views.RegionPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- Use the desktop screenshot as a background to ensure visibility. -->
        <Image
            x:Name="DesktopImage"
            Stretch="Fill"
            IsHitTestVisible="False" />

        <!-- Apply a subtle frosted-glass effect with a translucent white overlay. -->
        <Rectangle x:Name="FrostOverlay" Fill="#22FFFFFF" IsHitTestVisible="False" />

        <!-- Four masks cover the area outside the selection while its interior stays transparent. -->
        <Rectangle x:Name="ShadeTop" Fill="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />
        <Rectangle x:Name="ShadeLeft" Fill="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />
        <Rectangle x:Name="ShadeRight" Fill="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />
        <Rectangle x:Name="ShadeBottom" Fill="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />

        <Border
            x:Name="SelectionBorder"
            Background="Transparent"
            BorderBrush="Red"
            BorderThickness="2"
            Visibility="Collapsed"
            IsHitTestVisible="False" />

        <Rectangle
            x:Name="IndicatorRectangle"
            Stroke="Red"
            StrokeThickness="2"
            StrokeDashArray="4 3"
            Visibility="Collapsed"
            IsHitTestVisible="False" />

        <TextBlock
            x:Name="HintText"
            x:Uid="RegionPicker_Hint"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="White"
            IsHitTestVisible="False" />
    </Grid>
</Window>
