<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DawnCapture.Views.RegionPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择录制区域">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Background="#33000000"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <Canvas>
            <Border
                x:Name="SelectionBorder"
                BorderBrush="Red"
                BorderThickness="2"
                Background="#22FF0000"
                Visibility="Collapsed" />
        </Canvas>

        <Rectangle
            x:Name="IndicatorRectangle"
            Stroke="Red"
            StrokeThickness="2"
            StrokeDashArray="4 3"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="HintText"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="White"
            Text="拖拽选择录制区域，按 Esc 取消" />
    </Grid>
</Window>
