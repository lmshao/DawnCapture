<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DawnCapture.Views.RegionPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择录制区域">

    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- 未开始拖拽时的整屏浅色遮罩 -->
        <Rectangle x:Name="FullShade" Fill="#22000000" IsHitTestVisible="False" />

        <!-- 选区外四块遮罩：选区内部保持完全透明 -->
        <Rectangle x:Name="ShadeTop" Fill="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />
        <Rectangle x:Name="ShadeLeft" Fill="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />
        <Rectangle x:Name="ShadeRight" Fill="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />
        <Rectangle x:Name="ShadeBottom" Fill="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />

        <Border
            x:Name="SelectionBorder"
            Background="Transparent"
            BorderBrush="Red"
            BorderThickness="2"
            Visibility="Collapsed"
            IsHitTestVisible="False" />

        <Rectangle
            x:Name="IndicatorRectangle"
            Stroke="Red"
            StrokeThickness="2"
            StrokeDashArray="4 3"
            Visibility="Collapsed"
            IsHitTestVisible="False" />

        <TextBlock
            x:Name="HintText"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="White"
            Text="拖拽选择录制区域，按 Esc 取消"
            IsHitTestVisible="False" />
    </Grid>
</Window>
