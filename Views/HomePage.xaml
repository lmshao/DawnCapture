<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnCapture.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        Padding="32"
        Spacing="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <TextBlock Text="屏幕录制" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock
            Text="{Binding ElapsedText}"
            Style="{StaticResource TimerTextBlockStyle}" />

        <TextBlock
            Text="{Binding StatusText}"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel
            Orientation="Horizontal"
            Spacing="12"
            HorizontalAlignment="Center">

            <Button
                x:Name="DesktopButton"
                Content="桌面录制"
                Style="{StaticResource AccentButtonStyle}"
                Click="DesktopButton_Click" />

            <Button
                x:Name="WindowButton"
                Content="窗口录制"
                Click="WindowButton_Click" />

            <Button
                x:Name="RegionButton"
                Content="区域录制"
                Click="RegionButton_Click" />
        </StackPanel>

        <ListView
            x:Name="WindowList"
            Width="360"
            MaxHeight="240"
            HorizontalAlignment="Center"
            DisplayMemberPath="Title"
            SelectionMode="Single"
            SelectionChanged="WindowList_SelectionChanged"
            Visibility="Collapsed" />

        <StackPanel
            Orientation="Horizontal"
            Spacing="12"
            HorizontalAlignment="Center">

            <Button Content="暂停" Command="{Binding PauseCommand}" />

            <Button Content="继续" Command="{Binding ResumeCommand}" />

            <Button Content="停止" Command="{Binding StopCommand}" />
        </StackPanel>
    </StackPanel>
</Page>
