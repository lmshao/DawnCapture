<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnCapture.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        Padding="32"
        Spacing="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <TextBlock Text="屏幕录制" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock
            Text="{Binding ElapsedText}"
            Style="{StaticResource TimerTextBlockStyle}" />

        <TextBlock
            Text="{Binding StatusText}"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel
            Orientation="Horizontal"
            Spacing="12"
            HorizontalAlignment="Center">

            <Button
                Content="开始录制"
                Command="{Binding StartCommand}"
                Style="{StaticResource AccentButtonStyle}" />

            <Button Content="暂停" Command="{Binding PauseCommand}" />

            <Button Content="继续" Command="{Binding ResumeCommand}" />

            <Button Content="停止" Command="{Binding StopCommand}" />
        </StackPanel>
    </StackPanel>
</Page>
