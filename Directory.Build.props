<Project>
  <!--
    The one place the version is written by hand. DawnCapture.csproj inherits it, the
    SyncManifestVersions target pokes it into Package.appxmanifest and app.manifest, and
    distribute.ps1 reads it for artifact names and for the installer.

    Four parts because MSIX needs four, and the Store reserves the last one: it has to be 0
    in the package we build. The first part may not be 0 either.
  -->
  <PropertyGroup>
    <Version>1.0.0.0</Version>
  </PropertyGroup>
</Project>
